# URL e chaves do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key: NUNCA expor ao cliente, usada apenas em código server-only
# (ex.: convite/criação de usuários em /configuracoes/usuarios).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Envio de alerta de vencimento/reajuste por e-mail (via Gmail SMTP, ver README).
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Segredo compartilhado para autenticar as chamadas do cron job da Vercel ao endpoint
# /api/cron/contract-alerts. Gere um valor aleatório (ex.: `openssl rand -hex 32`).
CRON_SECRET=
